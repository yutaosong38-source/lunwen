[Main]
// Origin 2018b LabTalk, independent XY pairs for baseline + 10-70 kPa.
// IMAGE-ESTIMATED VERTICES, not instrument raw measurements.
// No random noise, fitting or smoothing is added.
newbook;
wks.nCols = 16;
wks.nRows = 11;
page.longname$ = "Time response IMAGE ESTIMATES";
wks.col1.type = 4;
wks.col2.type = 1;
col(A)[L]$ = "Time Baseline";
col(A)[U]$ = "s";
col(B)[L]$ = "Baseline";
col(B)[U]$ = "%";
col(A) = {0.3,1,1.7,2.4,3.1,3.8,4.5,5.2,5.9,6.6,7.2};
col(B) = {-0.6,-0.9,-0.6,-0.6,-0.9,-0.6,-0.8,-0.9,-0.6,-0.9,-1.3};
col(B)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT; baseline pressure not stated";
wks.col3.type = 4;
wks.col4.type = 1;
col(C)[L]$ = "Time 10kPa";
col(C)[U]$ = "s";
col(D)[L]$ = "10kPa";
col(D)[U]$ = "%";
col(C) = {7.9,9.5,11,12.4,13.8,15.3,17.2,18.6,19.3};
col(D) = {0,-7,0,-6.6,0,-6.6,0,-6.2,0};
col(D)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT";
wks.col5.type = 4;
wks.col6.type = 1;
col(E)[L]$ = "Time 20kPa";
col(E)[U]$ = "s";
col(F)[L]$ = "20kPa";
col(F)[U]$ = "%";
col(E) = {19.3,21.7,23.8,25.9,27.9,30,32.1,34.1,35.5};
col(F) = {0,-13.8,0,-13.8,0,-13,0,-13,0};
col(F)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT";
wks.col7.type = 4;
wks.col8.type = 1;
col(G)[L]$ = "Time 30kPa";
col(G)[U]$ = "s";
col(H)[L]$ = "30kPa";
col(H)[U]$ = "%";
col(G) = {35.5,38.6,41,43.4,46.2,48.4,51,53.4,55.9};
col(H) = {0,-20.9,0,-20.6,0,-20.9,0,-20.2,0};
col(H)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT";
wks.col9.type = 4;
wks.col10.type = 1;
col(I)[L]$ = "Time 40kPa";
col(I)[U]$ = "s";
col(J)[L]$ = "40kPa";
col(J)[U]$ = "%";
col(I) = {55.9,59,62.1,64.9,68.3,71,73.8,76.9,79.7};
col(J) = {0,-29.2,0,-27.7,0,-27.4,0,-27,0};
col(J)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT";
wks.col11.type = 4;
wks.col12.type = 1;
col(K)[L]$ = "Time 50kPa";
col(K)[U]$ = "s";
col(L)[L]$ = "50kPa";
col(L)[U]$ = "%";
col(K) = {79.7,83.4,86.9,90.3,93.8,97.4,100.7,104.5,107.6};
col(L) = {0,-36.8,0,-35.7,0,-34.9,0,-35.7,0};
col(L)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT";
wks.col13.type = 4;
wks.col14.type = 1;
col(M)[L]$ = "Time 60kPa";
col(M)[U]$ = "s";
col(N)[L]$ = "60kPa";
col(N)[U]$ = "%";
col(M) = {107.6,112.1,115.9,120,124.1,128.2,132.1,135.9,139.7};
col(N) = {0,-54.2,0,-52.6,0,-50.8,0,-50.4,0};
col(N)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT";
wks.col15.type = 4;
wks.col16.type = 1;
col(O)[L]$ = "Time 70kPa";
col(O)[U]$ = "s";
col(P)[L]$ = "70kPa";
col(P)[U]$ = "%";
col(O) = {139.7,144.7,149,153.8,157.9,162.8,166.9,171.7,176.2};
col(P) = {0,-63.6,0,-59.8,0,-60.9,0,-59.8,0};
col(P)[C]$ = "IMAGE_ESTIMATE_NOT_RAW_MEASUREMENT";
string tnBook$ = %H;
plotxy iy:=(1,2) plot:=200 ogl:=<new>;
string tnGraph$ = %H;
plotxy iy:=[%(tnBook$)]1!(3,4) plot:=200 ogl:=[%(tnGraph$)]1!;
plotxy iy:=[%(tnBook$)]1!(5,6) plot:=200 ogl:=[%(tnGraph$)]1!;
plotxy iy:=[%(tnBook$)]1!(7,8) plot:=200 ogl:=[%(tnGraph$)]1!;
plotxy iy:=[%(tnBook$)]1!(9,10) plot:=200 ogl:=[%(tnGraph$)]1!;
plotxy iy:=[%(tnBook$)]1!(11,12) plot:=200 ogl:=[%(tnGraph$)]1!;
plotxy iy:=[%(tnBook$)]1!(13,14) plot:=200 ogl:=[%(tnGraph$)]1!;
plotxy iy:=[%(tnBook$)]1!(15,16) plot:=200 ogl:=[%(tnGraph$)]1!;
layer -gu;
layer -s 1;
tnColor = color(85,85,85);
set %C -c $(tnColor);
layer -s 2;
tnColor = color(38,175,91);
set %C -c $(tnColor);
layer -s 3;
tnColor = color(173,103,220);
set %C -c $(tnColor);
layer -s 4;
tnColor = color(23,108,236);
set %C -c $(tnColor);
layer -s 5;
tnColor = color(241,54,61);
set %C -c $(tnColor);
layer -s 6;
tnColor = color(255,102,0);
set %C -c $(tnColor);
layer -s 7;
tnColor = color(0,186,199);
set %C -c $(tnColor);
layer -s 8;
tnColor = color(199,153,0);
set %C -c $(tnColor);
page.longname$ = "Time response IMAGE ESTIMATES - Arial 28";
layer.x.type = 1;
layer.y.type = 1;
layer.x.from = 0;
layer.x.to = 180;
layer.x.inc = 20;
layer.y.from = -70;
layer.y.to = 5;
layer.y.inc = 20;
tnFont = font("Arial");
label -xb "Time (s)";
label -yl "\g(D)R/R\-(0) (%)";
xb.font = tnFont;
yl.font = tnFont;
xb.fsize = 28;
yl.fsize = 28;
layer.x.label.font = tnFont;
layer.y.label.font = tnFont;
layer.x.label.pt = 28;
layer.y.label.pt = 28;
layer.left = 20;
layer.top = 18;
layer.width = 72;
layer.height = 68;
// Inline pressure labels reproduce the source layout; baseline remains unassigned.
label -r legend;
label -n Pressure10 "10 kPa";
Pressure10.font = tnFont;
Pressure10.fsize = 28;
Pressure10.attach = 2;
Pressure10.x1 = 9.6;
Pressure10.y1 = -11;
Pressure10.color = color(38,175,91);
label -n Pressure20 "20 kPa";
Pressure20.font = tnFont;
Pressure20.fsize = 28;
Pressure20.attach = 2;
Pressure20.x1 = 23.4;
Pressure20.y1 = -17.8;
Pressure20.color = color(173,103,220);
label -n Pressure30 "30 kPa";
Pressure30.font = tnFont;
Pressure30.fsize = 28;
Pressure30.attach = 2;
Pressure30.x1 = 41.7;
Pressure30.y1 = -24.9;
Pressure30.color = color(23,108,236);
label -n Pressure40 "40 kPa";
Pressure40.font = tnFont;
Pressure40.fsize = 28;
Pressure40.attach = 2;
Pressure40.x1 = 63.8;
Pressure40.y1 = -33.2;
Pressure40.color = color(241,54,61);
label -n Pressure50 "50 kPa";
Pressure50.font = tnFont;
Pressure50.fsize = 28;
Pressure50.attach = 2;
Pressure50.x1 = 89.7;
Pressure50.y1 = -40.8;
Pressure50.color = color(255,102,0);
label -n Pressure60 "60 kPa";
Pressure60.font = tnFont;
Pressure60.fsize = 28;
Pressure60.attach = 2;
Pressure60.x1 = 119.6;
Pressure60.y1 = -58.2;
Pressure60.color = color(0,186,199);
label -n Pressure70 "70 kPa";
Pressure70.font = tnFont;
Pressure70.fsize = 28;
Pressure70.attach = 2;
Pressure70.x1 = 153.9;
Pressure70.y1 = -67.6;
Pressure70.color = color(199,153,0);
label -n DataKindNote "IMAGE-DERIVED";
DataKindNote.font = tnFont;
DataKindNote.fsize = 28;
DataKindNote.attach = 2;
DataKindNote.x1 = 2;
DataKindNote.y1 = 13;
type "Created time-response plot: image-estimated turning points.";
type "Target Origin 2018b. X: Time (s), Y: Delta R / R0 (%), Arial 28.";

